{
  "name": "alexa-ma-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Admin panel for the Alexa MA Skill integration.",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.1",
    "rollup": "4.68.8",
    "tslib": "2.9.1",
    "typescript": "5.9.3"
  }
}
